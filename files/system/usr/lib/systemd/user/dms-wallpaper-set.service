[Unit]
Description=Set default wallpaper once after dms.service
After=graphical-session.target dms.service
Requires=dms.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for attempt in {1..30}; do output=$(/usr/bin/dms ipc call wallpaper clear 2>&1); if [[ "$output" != *"Target not found."* ]]; then output=$(/usr/bin/dms ipc call wallpaper set /usr/share/backgrounds/niri-tomic-os/b70e993b-c633-4f66-b879-bada2a116d49.png 2>&1); if [[ "$output" != *"Target not found."* ]]; then [[ -n "$output" ]] && printf "%%s\n" "$output"; exit 0; fi; fi; sleep 1; done; echo "DMS wallpaper IPC target did not become ready" >&2; exit 1'
StandardOutput=journal

[Install]
WantedBy=graphical-session.target
